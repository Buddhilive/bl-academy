---
interface Props {
  slotId?: string;
  className?: string;
  client?: string;
}

const {
  slotId = 'default-slot',
  className = '',
  client = import.meta.env.PUBLIC_ADSENSE_CLIENT,
} = Astro.props;
---

<div
  class:list={[
    "w-full min-h-[90px] bg-neutral-900/50 border border-neutral-850 border-dashed rounded-lg flex flex-col items-center justify-center p-2 text-center overflow-hidden my-4",
    className
  ]}
  role="region"
  aria-label="Advertisement"
>
  {client ? (
    <ins
      class="adsbygoogle"
      style="display:block; min-height: 90px; width: 100%;"
      data-ad-client={client}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
  ) : (
    <div class="flex items-center gap-2 text-xs text-neutral-500 font-mono select-none">
      <span class="w-2 h-2 rounded-full bg-neutral-700" aria-hidden="true" />
      <span>Sponsored Space (90px reserved)</span>
    </div>
  )}
</div>

