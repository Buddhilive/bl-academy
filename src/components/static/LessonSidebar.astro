---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentTrack: string;
  currentSlug: string;
  lessons: CollectionEntry<'lessons'>[];
}

const { currentTrack, currentSlug, lessons } = Astro.props;

// Filter track and sort ascending by order, tiebreak by id
const trackLessons = lessons
  .filter((l) => l.data.track === currentTrack)
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

// Group lessons by category (W3Schools section headers)
const categoriesMap = new Map<string, CollectionEntry<'lessons'>[]>();
for (const lesson of trackLessons) {
  const cat = lesson.data.category || 'Tutorial';
  if (!categoriesMap.has(cat)) {
    categoriesMap.set(cat, []);
  }
  categoriesMap.get(cat)!.push(lesson);
}
const categories = Array.from(categoriesMap.entries());
---

<aside class="w-full lg:w-72 shrink-0">
  <!-- Mobile Collapsible Details Disclosure -->
  <details class="lg:hidden mb-4 bg-neutral-900 border border-neutral-800 rounded-lg p-3 group">
    <summary class="font-medium cursor-pointer flex items-center justify-between text-neutral-200 select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E07A5F]">
      <span class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <span class="capitalize">{currentTrack} Tutorial</span> ({trackLessons.length} topics)
      </span>
      <span class="text-xs text-neutral-400 group-open:rotate-180 transition-transform">▼</span>
    </summary>
    <div class="mt-4 pt-4 border-t border-neutral-800 space-y-4">
      {categories.map(([categoryName, catLessons]) => (
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-400 px-3 mb-1">
            {categoryName}
          </h3>
          <nav aria-label={`${categoryName} (mobile)`} class="space-y-0.5">
            {catLessons.map((lesson) => {
              const isActive = lesson.id === currentSlug;
              return (
                <a
                  href={`/learn/${lesson.data.track}/${lesson.id}`}
                  class:list={[
                    "flex items-center justify-between px-3 py-1.5 rounded-md text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E07A5F]",
                    isActive
                      ? "bg-[#A7452A]/20 text-[#E07A5F] font-semibold border-l-2 border-[#E07A5F]"
                      : "text-neutral-300 hover:bg-neutral-800 hover:text-white"
                  ]}
                  aria-current={isActive ? "page" : undefined}
                  data-sidebar-lesson-slug={lesson.id}
                >
                  <span class="truncate">{lesson.data.title}</span>
                  <span class="sidebar-check-badge hidden text-emerald-400 text-xs font-medium shrink-0 ml-2" aria-label="Completed">
                    ✓
                  </span>
                </a>
              );
            })}
          </nav>
        </div>
      ))}
    </div>
  </details>

  <!-- Desktop Fixed/Sticky Navigation Sidebar -->
  <div class="hidden lg:block sticky top-6 max-h-[calc(100vh-4rem)] overflow-y-auto bg-neutral-900/60 border border-neutral-800 rounded-xl p-3 backdrop-blur-sm scrollbar-thin">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-neutral-800 px-2">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#E07A5F]">
        {currentTrack} Tutorial
      </h2>
      <span class="text-[11px] text-neutral-500 font-mono">
        {trackLessons.length} topics
      </span>
    </div>

    <div class="space-y-4">
      {categories.map(([categoryName, catLessons]) => (
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-400 px-2 py-1 mb-0.5">
            {categoryName}
          </h3>
          <nav aria-label={categoryName} class="space-y-0.5">
            {catLessons.map((lesson) => {
              const isActive = lesson.id === currentSlug;
              return (
                <a
                  href={`/learn/${lesson.data.track}/${lesson.id}`}
                  class:list={[
                    "group flex items-center justify-between px-2.5 py-1.5 rounded-md text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E07A5F]",
                    isActive
                      ? "bg-[#A7452A]/20 text-[#E07A5F] font-medium border-l-2 border-[#E07A5F]"
                      : "text-neutral-300 hover:bg-neutral-800/80 hover:text-white"
                  ]}
                  aria-current={isActive ? "page" : undefined}
                  data-sidebar-lesson-slug={lesson.id}
                >
                  <span class="truncate text-[13px]">{lesson.data.title}</span>
                  
                  <div class="flex items-center gap-1.5 shrink-0 ml-2">
                    <span class="sidebar-check-badge hidden text-emerald-400 text-xs font-semibold" title="Completed">
                      <span class="sr-only">(Completed)</span>
                      ✓
                    </span>
                    <span class="text-[10px] text-neutral-500 font-mono">
                      {lesson.data.xp}xp
                    </span>
                  </div>
                </a>
              );
            })}
          </nav>
        </div>
      ))}
    </div>
  </div>
</aside>
