---
import 'katex/dist/katex.min.css';
import Layout from './Layout.astro';
import LessonSidebar from '../components/static/LessonSidebar.astro';
import LessonProgressPanel from '../components/islands/LessonProgressPanel';
import LessonFooter from '../components/islands/LessonFooter';
import AdSlot from '../components/static/AdSlot.astro';
import type { CollectionEntry } from 'astro:content';
import {
  buildTrackUrlMap,
  getAdjacentCourses,
  getCourseByTrack,
  getSortedLessonsForTrack,
  resolveCourseEntryUrl,
} from '../lib/curriculum';

interface Props {
  entry: CollectionEntry<'lessons'>;
  allLessons?: CollectionEntry<'lessons'>[];
}

const { entry, allLessons = [] } = Astro.props;
const { title, description } = entry.data;

const currentCourse = getCourseByTrack(entry.data.track);
const { prevCourse, nextCourse } = getAdjacentCourses(entry.data.track);
const trackUrls = buildTrackUrlMap(allLessons);

// Filter track and sort ascending by order
const trackLessons = getSortedLessonsForTrack(entry.data.track, allLessons);

// Summary for progress panel
const trackLessonSummaries = trackLessons.map((l) => ({
  id: l.id,
  order: l.data.order,
  xp: l.data.xp,
}));

// Previous and Next topics (with cross-course boundary handoff)
const currentIndex = trackLessons.findIndex((l) => l.id === entry.id);
const prevLesson = currentIndex > 0 ? trackLessons[currentIndex - 1] : null;
const nextLesson = currentIndex >= 0 && currentIndex < trackLessons.length - 1 ? trackLessons[currentIndex + 1] : null;

let prevUrl: string | null = prevLesson ? `/learn/${prevLesson.data.track}/${prevLesson.id}` : null;
let prevLabel = '❮ Previous';
if (!prevUrl && prevCourse) {
  const prevCourseLessons = getSortedLessonsForTrack(prevCourse.track, allLessons);
  prevUrl =
    prevCourseLessons.length > 0
      ? `/learn/${prevCourse.track}/${prevCourseLessons[prevCourseLessons.length - 1].id}`
      : `/learn/${prevCourse.track}`;
  prevLabel = `❮ Course ${prevCourse.stepCode}: ${prevCourse.shortLabel}`;
}

let nextUrl: string | null = nextLesson ? `/learn/${nextLesson.data.track}/${nextLesson.id}` : null;
let nextLabel = 'Next ❯';
let nextTitle = nextLesson?.data.title;
let nextFooterActionLabel: string | undefined = undefined;

if (!nextUrl && nextCourse) {
  nextUrl = resolveCourseEntryUrl(nextCourse.track, allLessons);
  nextLabel = `Next Course: ${nextCourse.shortLabel} ❯`;
  nextTitle = `Course ${nextCourse.stepCode}: ${nextCourse.title}`;
  nextFooterActionLabel = `Complete & Continue to Course ${nextCourse.stepCode}`;
}

const siteBase = Astro.site ?? new URL('https://academy.buddhilive.com');
const lessonUrl = new URL(`/learn/${entry.data.track}/${entry.id}`, siteBase).toString();
const courseUrl = new URL(`/learn/${entry.data.track}`, siteBase).toString();

const lessonJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LearningResource',
      name: title,
      description,
      url: lessonUrl,
      learningResourceType: 'Tutorial',
      educationalLevel: entry.data.difficulty,
      isPartOf: {
        '@type': 'Course',
        name: currentCourse ? `Course ${currentCourse.stepCode}: ${currentCourse.title}` : entry.data.track,
        url: courseUrl,
      },
      provider: {
        '@type': 'EducationalOrganization',
        name: 'BuddhiAI Academy',
        url: siteBase.toString().replace(/\/$/, ''),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteBase.toString().replace(/\/$/, ''),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: currentCourse ? `Course ${currentCourse.stepCode}: ${currentCourse.title}` : entry.data.track,
          item: courseUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: lessonUrl,
        },
      ],
    },
  ],
};
---

<Layout title={`${title} | BuddhiAI Academy`} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(lessonJsonLd)} />
  <slot name="head" slot="head" />
  
  <div class="min-h-screen flex flex-col bg-neutral-950 text-neutral-100">
    {/* Top Navigation & Live Progress Panel */}
    <slot name="top-nav">
      <LessonProgressPanel
        client:load
        currentTrack={entry.data.track}
        currentSlug={entry.id}
        trackLessons={trackLessonSummaries}
        trackUrls={trackUrls}
      />
    </slot>

    <div class="flex-1 max-w-7xl w-full mx-auto flex flex-col lg:flex-row px-4 sm:px-6 lg:px-8 py-6 gap-8">
      {/* Dynamic sidebar */}
      <slot name="sidebar">
        <LessonSidebar
          currentTrack={entry.data.track}
          currentSlug={entry.id}
          lessons={allLessons}
        />
      </slot>

      {/* Main lesson content */}
      <main id="main-content" class="flex-1 min-w-0 max-w-4xl">
        <slot name="top-banner">
          <AdSlot slotId={import.meta.env.PUBLIC_ADSENSE_TOP_SLOT_ID || '9280073752'} format="auto" className="mb-6" />
        </slot>

        <article class="prose prose-invert prose-neutral max-w-none prose-headings:font-semibold prose-headings:text-neutral-100 prose-a:text-[#E07A5F] hover:prose-a:underline prose-code:text-[#E07A5F] prose-pre:bg-neutral-900 prose-pre:border prose-pre:border-neutral-800">
          <header class="mb-6 border-b border-neutral-800 pb-4">
            <div class="flex flex-wrap items-center gap-2.5 text-sm text-neutral-400 mb-2">
              <a
                href={`/learn/${entry.data.track}`}
                class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-200 hover:border-[#E07A5F] no-underline"
              >
                {currentCourse ? `Course ${currentCourse.stepCode}: ${currentCourse.title}` : entry.data.track}
              </a>
              <span>•</span>
              <span class="text-xs font-medium text-neutral-300">
                {entry.data.category}
              </span>
              <span>•</span>
              <span class="text-xs font-medium text-amber-400">
                +{entry.data.xp} XP
              </span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">
              {entry.data.title}
            </h1>
            <p class="text-base sm:text-lg text-neutral-400 mb-4">
              {entry.data.description}
            </p>

            {/* W3Schools-style Top Prev / Next Navigation */}
            <div class="flex flex-wrap items-center justify-between gap-2.5 pt-2 border-t border-neutral-800/60 not-prose">
              {prevUrl ? (
                <a
                  href={prevUrl}
                  class="inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-2 text-xs sm:text-sm font-semibold rounded-md bg-neutral-800 hover:bg-neutral-700 text-neutral-200 transition-colors max-w-full truncate focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E07A5F]"
                >
                  <span class="truncate">{prevLabel}</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-2 text-xs sm:text-sm font-semibold rounded-md bg-neutral-900/40 text-neutral-600 cursor-not-allowed">
                  ❮ Previous
                </span>
              )}

              {nextUrl ? (
                <a
                  href={nextUrl}
                  class="inline-flex items-center gap-1.5 min-h-[44px] px-4 py-2 text-xs sm:text-sm font-semibold rounded-md bg-[#A7452A] hover:bg-[#93371E] dark:bg-[#E07A5F] dark:hover:bg-[#E58A73] text-white dark:text-neutral-950 shadow-sm transition-colors max-w-full truncate focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E07A5F]"
                >
                  <span class="truncate">{nextLabel}</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-2 text-xs sm:text-sm font-semibold rounded-md bg-neutral-900/40 text-neutral-600 cursor-not-allowed">
                  Next ❯
                </span>
              )}
            </div>
          </header>

          <slot />
        </article>

        {/* Bottom Navigation with Pathfinder XP & Complete */}
        <div class="mt-12 not-prose">
          <LessonFooter
            client:load
            lessonSlug={entry.id}
            xp={entry.data.xp}
            nextLessonUrl={nextUrl || undefined}
            nextLessonTitle={nextTitle}
            nextActionLabel={nextFooterActionLabel}
            sticky={false}
          />
        </div>
      </main>
    </div>
  </div>
</Layout>

<style is:global>
  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem 0;
    -webkit-overflow-scrolling: touch;
  }
  .prose pre {
    max-width: 100%;
    overflow-x: auto;
  }
</style>
