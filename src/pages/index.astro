---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allLessons = await getCollection('lessons');
const pythonLessons = allLessons
  .filter((l) => l.data.track === 'python')
  .sort((a, b) => a.data.order - b.data.order);

const firstLesson = pythonLessons[0];
const firstLessonUrl = firstLesson ? `/learn/${firstLesson.data.track}/${firstLesson.id}` : '#';

const subjects = [
  {
    name: 'Python',
    description: 'A popular high-level programming language for web, data science, and scripting.',
    href: firstLessonUrl,
    badge: 'Popular',
    color: '#A7452A',
  },
  {
    name: 'NumPy',
    description: 'The fundamental package for scientific computing and matrix arrays in Python.',
    href: '#',
    badge: 'Coming Soon',
    color: '#3B82F6',
  },
  {
    name: 'Pandas',
    description: 'Fast, powerful, flexible and easy-to-use open-source data analysis tool.',
    href: '#',
    badge: 'Coming Soon',
    color: '#10B981',
  },
  {
    name: 'Data Structures & Algorithms',
    description: 'Master binary trees, graphs, sorting, and asymptotic Big-O runtime analysis.',
    href: '#',
    badge: 'Coming Soon',
    color: '#8B5CF6',
  },
];
---

<Layout title="BuddhiLive Academy - Learn to Code with Interactive Tutorials">
  <div class="min-h-screen bg-neutral-950 text-neutral-100 flex flex-col">
    {/* Navigation */}
    <header class="border-b border-neutral-800 bg-neutral-900/80 backdrop-blur-sm sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 font-extrabold text-lg text-white">
          <span class="w-7 h-7 rounded bg-[#A7452A] flex items-center justify-center text-xs text-white">
            BL
          </span>
          <span>BuddhiLive Academy</span>
        </a>

        <div class="flex items-center gap-4">
          <a
            href={firstLessonUrl}
            class="px-4 py-2 text-xs sm:text-sm font-semibold rounded-md bg-[#A7452A] hover:bg-[#93371E] text-white shadow-sm transition-colors"
          >
            Start Learning Python »
          </a>
        </div>
      </div>
    </header>

    {/* Hero Section */}
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
          Learn to Code with Free Interactive Tutorials
        </h1>
        <p class="text-lg text-neutral-400 mb-8">
          Clear, scannable tutorials and syntax reference tables with built-in client-side code execution. Run and experiment directly in your browser.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href={firstLessonUrl}
            class="px-6 py-3 text-sm font-bold rounded-lg bg-[#A7452A] hover:bg-[#93371E] text-white shadow-md transition-all"
          >
            Start Python Tutorial ❮ ❯
          </a>
          <a
            href="#subjects"
            class="px-6 py-3 text-sm font-semibold rounded-lg bg-neutral-900 border border-neutral-800 text-neutral-200 hover:bg-neutral-800 transition-colors"
          >
            Browse All Subjects
          </a>
        </div>
      </div>

      {/* Featured Try It Yourself Example Box */}
      <section class="mb-16 bg-neutral-900 border border-neutral-800 rounded-xl p-6 sm:p-8 max-w-4xl mx-auto shadow-sm">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-neutral-800">
          <div>
            <span class="text-xs font-bold text-[#E07A5F] uppercase tracking-wider">Interactive Example</span>
            <h2 class="text-xl font-bold text-white mt-0.5">Python Syntax</h2>
          </div>
          <span class="text-xs px-2.5 py-1 rounded-full bg-neutral-800 text-neutral-300 font-mono">
            Pure Client-Side
          </span>
        </div>

        <p class="text-neutral-400 text-sm mb-4">
          Try running this code directly. You don't need to install anything on your machine:
        </p>

        <div class="bg-neutral-950 p-4 rounded-lg font-mono text-sm text-neutral-200 border border-neutral-800/80 mb-4 overflow-x-auto">
          <pre><span class="text-purple-400">def</span> <span class="text-blue-400">welcome</span>(name):
    <span class="text-purple-400">return</span> <span class="text-amber-300">f"Hello, &#123;name&#125;! Welcome to BuddhiLive Academy."</span>

print(welcome(<span class="text-amber-300">"Developer"</span>))</pre>
        </div>

        <a
          href={firstLessonUrl}
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-md bg-[#A7452A] hover:bg-[#93371E] text-white transition-colors"
        >
          Try it in Sandbox »
        </a>
      </section>

      {/* Subjects Grid */}
      <section id="subjects">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-2xl font-bold text-white">Tutorial Subjects</h2>
            <p class="text-sm text-neutral-400">Systematic learning tracks & references</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {subjects.map((sub) => (
            <a
              href={sub.href}
              class="group block p-6 rounded-xl bg-neutral-900/60 border border-neutral-800 hover:border-neutral-700 hover:bg-neutral-900 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E07A5F]"
            >
              <div class="flex items-center justify-between mb-4">
                <span class="w-3 h-3 rounded-full" style={`background-color: ${sub.color}`} />
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-neutral-800 text-neutral-300">
                  {sub.badge}
                </span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-[#E07A5F] transition-colors mb-2">
                {sub.name}
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed mb-4">
                {sub.description}
              </p>
              <span class="text-xs font-semibold text-[#E07A5F] group-hover:underline inline-flex items-center gap-1">
                Explore Tutorial »
              </span>
            </a>
          ))}
        </div>
      </section>
    </main>

    {/* Footer */}
    <footer class="border-t border-neutral-800 bg-neutral-900/40 py-8 text-center text-xs text-neutral-500">
      <div class="max-w-7xl mx-auto px-4">
        <p>© 2026 BuddhiLive Academy. Fast, accessible, client-side developer reference.</p>
      </div>
    </footer>
  </div>
</Layout>
